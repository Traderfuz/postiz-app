# Boxi reliability overlay: keep upstream v2.24.0 immutable and replace only
# the built orchestrator output produced from this source branch.
ARG POSTIZ_BASE=ghcr.io/gitroomhq/postiz-app@sha256:01b24a4fc1055f6833122c99614805bea702fdc0ee30c9b5d09330b521fa1efa
FROM ${POSTIZ_BASE}

LABEL org.opencontainers.image.source="https://github.com/Traderfuz/postiz-app"
LABEL org.opencontainers.image.description="Boxi Postiz reliability overlay"

COPY apps/backend/dist/ /app/apps/backend/dist/
COPY apps/orchestrator/dist/ /app/apps/orchestrator/dist/
